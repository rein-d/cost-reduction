<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VitaStore_Onboarding" targetNamespace="http://vitastore.ru/bpmn/onboarding" exporter="VitaStore BA" exporterVersion="1.2">
  <bpmn:collaboration id="Collaboration_Onboarding">
    <bpmn:participant id="P_HQ" name="Команда онбординга VitaStore (HQ)" processRef="Process_P_HQ" />
    <bpmn:participant id="P_ORCH" name="Оркестратор онбординга (iPaaS)" processRef="Process_P_ORCH" />
    <bpmn:participant id="P_STORE" name="Магазин (купленная точка)" processRef="Process_P_STORE" />
    <bpmn:participant id="P_AI" name="Сервис матчинга SKU (ИИ)" processRef="Process_P_AI" />
    <bpmn:participant id="P_PIM" name="PIM / MDM" processRef="Process_P_PIM" />
    <bpmn:participant id="P_ERP" name="SAP ERP" processRef="Process_P_ERP" />
    <bpmn:participant id="P_POS" name="Cloud POS" processRef="Process_P_POS" />
    <bpmn:messageFlow id="MF_01" name="кейс онбординга" sourceRef="HQ_case" targetRef="OR_start" />
    <bpmn:messageFlow id="MF_02" name="задание на выгрузку" sourceRef="OR_case" targetRef="ST_start" />
    <bpmn:messageFlow id="MF_03" name="выгрузка номенклатуры" sourceRef="ST_upload" targetRef="OR_intake" />
    <bpmn:messageFlow id="MF_04" name="батч и снимок PIM" sourceRef="OR_call_ai" targetRef="AI_start" />
    <bpmn:messageFlow id="MF_05" name="таблица маппинга" sourceRef="AI_send" targetRef="OR_call_ai" />
    <bpmn:messageFlow id="MF_06" name="очередь исключений" sourceRef="OR_route" targetRef="HQ_catch_exc" />
    <bpmn:messageFlow id="MF_07" name="подтверждённый маппинг" sourceRef="HQ_approve" targetRef="OR_wait" />
    <bpmn:messageFlow id="MF_08" name="пересчёт с усиленными порогами" sourceRef="HQ_retrain" targetRef="OR_wait" />
    <bpmn:messageFlow id="MF_09" name="мастер-данные и маппинг" sourceRef="OR_to_pim" targetRef="PIM_start" />
    <bpmn:messageFlow id="MF_10" name="ассортимент" sourceRef="PIM_publish" targetRef="ERP_catch_assort" />
    <bpmn:messageFlow id="MF_11" name="каталог и цены" sourceRef="ERP_publish" targetRef="POS_catch_catalog" />
    <bpmn:messageFlow id="MF_12" name="касса готова" sourceRef="POS_ready" targetRef="ST_catch_ready" />
    <bpmn:messageFlow id="MF_13" name="магазин принят" sourceRef="ST_accept" targetRef="OR_catch_accept" />
    <bpmn:messageFlow id="MF_14" name="кейс закрыт" sourceRef="OR_close" targetRef="HQ_catch_closed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P_HQ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_HQ">
      <bpmn:lane id="L_HQManager" name="Менеджер">
        <bpmn:flowNodeRef>HQ_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HQ_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HQ_catch_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HQ_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_HQReviewer" name="Товаровед">
        <bpmn:flowNodeRef>HQ_catch_exc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HQ_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HQ_gw_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HQ_retrain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_HQCategory" name="Категорийный">
        <bpmn:flowNodeRef>HQ_approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="HQ_start" name="Сделка закрыта">
      <bpmn:outgoing>SF_HQ_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="HQ_case" name="Открыть кейс и передать в оркестратор">
      <bpmn:incoming>SF_HQ_1</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="HQ_catch_exc" name="Исключения">
      <bpmn:incoming>SF_HQ_2</bpmn:incoming>
      <bpmn:incoming>SF_HQ_7</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="HQ_catch_exc_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="HQ_review" name="Разобрать исключения и аудит">
      <bpmn:incoming>SF_HQ_3</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="HQ_gw_audit" name="Ошибок ≤ 1%?">
      <bpmn:incoming>SF_HQ_4</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_5</bpmn:outgoing>
      <bpmn:outgoing>SF_HQ_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="HQ_retrain" name="Вернуть на пересчёт">
      <bpmn:incoming>SF_HQ_6</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="HQ_approve" name="Согласовать SKU и батч (4 глаза)">
      <bpmn:incoming>SF_HQ_5</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="HQ_catch_closed" name="Кейс закрыт">
      <bpmn:incoming>SF_HQ_8</bpmn:incoming>
      <bpmn:outgoing>SF_HQ_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="HQ_catch_closed_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="HQ_end" name="Онбординг завершён">
      <bpmn:incoming>SF_HQ_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="AN_AI"><bpmn:text>Порог авто: confidence ≥ 0,95 и отрыв от второго кандидата ≥ 0,08. Алкоголь и табак — всегда вручную.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="AN_LEGEND"><bpmn:text>Обозначения: прямоугольник — задача, ромб — шлюз, круг — событие, страница — объект данных; сплошная линия — последовательность, пунктир — сообщение.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="AN_SIMPLIFY"><bpmn:text>Одна задача — один логический шаг. Внутренние шаги матчинга, аудита и приёмки раскрыты в README.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="AN_PARALLEL"><bpmn:text>ERP и Cloud POS стартуют по кейсу одновременно с выгрузкой: матчинг и подготовка идут параллельно.</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="SF_HQ_1" sourceRef="HQ_start" targetRef="HQ_case" />
    <bpmn:sequenceFlow id="SF_HQ_2" sourceRef="HQ_case" targetRef="HQ_catch_exc" />
    <bpmn:sequenceFlow id="SF_HQ_3" sourceRef="HQ_catch_exc" targetRef="HQ_review" />
    <bpmn:sequenceFlow id="SF_HQ_4" sourceRef="HQ_review" targetRef="HQ_gw_audit" />
    <bpmn:sequenceFlow id="SF_HQ_5" sourceRef="HQ_gw_audit" targetRef="HQ_approve" name="да" />
    <bpmn:sequenceFlow id="SF_HQ_6" sourceRef="HQ_gw_audit" targetRef="HQ_retrain" name="нет" />
    <bpmn:sequenceFlow id="SF_HQ_7" sourceRef="HQ_retrain" targetRef="HQ_catch_exc" />
    <bpmn:sequenceFlow id="SF_HQ_8" sourceRef="HQ_approve" targetRef="HQ_catch_closed" />
    <bpmn:sequenceFlow id="SF_HQ_9" sourceRef="HQ_catch_closed" targetRef="HQ_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_ORCH" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_ORCH">
      <bpmn:lane id="L_Orchestrator" name="Оркестрация и SLA">
        <bpmn:flowNodeRef>OR_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_call_ai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_to_pim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_catch_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OR_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OR_start" name="Кейс онбординга">
      <bpmn:outgoing>SF_OR_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="OR_start_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="OR_case" name="Открыть кейс, SLA 5 дней">
      <bpmn:incoming>SF_OR_1</bpmn:incoming>
      <bpmn:outgoing>SF_OR_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OR_intake" name="Принять и проверить выгрузку">
      <bpmn:incoming>SF_OR_2</bpmn:incoming>
      <bpmn:outgoing>SF_OR_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_01">
        <bpmn:targetRef>DO_extract</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OR_call_ai" name="Вызвать сервис матчинга">
      <bpmn:incoming>SF_OR_3</bpmn:incoming>
      <bpmn:incoming>SF_OR_8</bpmn:incoming>
      <bpmn:outgoing>SF_OR_4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_02">
        <bpmn:targetRef>DO_batch</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="OR_route" name="Разложить и отправить исключения">
      <bpmn:incoming>SF_OR_4</bpmn:incoming>
      <bpmn:outgoing>SF_OR_5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_03">
        <bpmn:targetRef>DO_mapping</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DA_04">
        <bpmn:targetRef>DO_exceptions</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="OR_wait" name="Получить решение HQ">
      <bpmn:incoming>SF_OR_5</bpmn:incoming>
      <bpmn:outgoing>SF_OR_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="OR_gw" name="Батч принят?">
      <bpmn:incoming>SF_OR_6</bpmn:incoming>
      <bpmn:outgoing>SF_OR_7</bpmn:outgoing>
      <bpmn:outgoing>SF_OR_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="OR_to_pim" name="Передать батч в PIM">
      <bpmn:incoming>SF_OR_7</bpmn:incoming>
      <bpmn:outgoing>SF_OR_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="OR_catch_accept" name="Магазин принят">
      <bpmn:incoming>SF_OR_9</bpmn:incoming>
      <bpmn:outgoing>SF_OR_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="OR_catch_accept_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="OR_close" name="Закрыть кейс и метрики">
      <bpmn:incoming>SF_OR_10</bpmn:incoming>
      <bpmn:outgoing>SF_OR_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OR_end" name="Кейс закрыт">
      <bpmn:incoming>SF_OR_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_DO_extract" name="Выгрузка"/>
    <bpmn:dataObjectReference id="DO_extract" name="Выгрузка" dataObjectRef="DataObject_DO_extract" />
    <bpmn:dataObject id="DataObject_DO_batch" name="Батч (JSON)"/>
    <bpmn:dataObjectReference id="DO_batch" name="Батч (JSON)" dataObjectRef="DataObject_DO_batch" />
    <bpmn:dataObject id="DataObject_DO_mapping" name="Маппинг"/>
    <bpmn:dataObjectReference id="DO_mapping" name="Маппинг" dataObjectRef="DataObject_DO_mapping" />
    <bpmn:dataObject id="DataObject_DO_exceptions" name="Исключения"/>
    <bpmn:dataObjectReference id="DO_exceptions" name="Исключения" dataObjectRef="DataObject_DO_exceptions" />
    <bpmn:sequenceFlow id="SF_OR_1" sourceRef="OR_start" targetRef="OR_case" />
    <bpmn:sequenceFlow id="SF_OR_2" sourceRef="OR_case" targetRef="OR_intake" />
    <bpmn:sequenceFlow id="SF_OR_3" sourceRef="OR_intake" targetRef="OR_call_ai" />
    <bpmn:sequenceFlow id="SF_OR_4" sourceRef="OR_call_ai" targetRef="OR_route" />
    <bpmn:sequenceFlow id="SF_OR_5" sourceRef="OR_route" targetRef="OR_wait" />
    <bpmn:sequenceFlow id="SF_OR_6" sourceRef="OR_wait" targetRef="OR_gw" />
    <bpmn:sequenceFlow id="SF_OR_7" sourceRef="OR_gw" targetRef="OR_to_pim" name="да" />
    <bpmn:sequenceFlow id="SF_OR_8" sourceRef="OR_gw" targetRef="OR_call_ai" name="пересчёт" />
    <bpmn:sequenceFlow id="SF_OR_9" sourceRef="OR_to_pim" targetRef="OR_catch_accept" />
    <bpmn:sequenceFlow id="SF_OR_10" sourceRef="OR_catch_accept" targetRef="OR_close" />
    <bpmn:sequenceFlow id="SF_OR_11" sourceRef="OR_close" targetRef="OR_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_STORE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_STORE">
      <bpmn:lane id="L_Store" name="Управляющий / кассовый агент">
        <bpmn:flowNodeRef>ST_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_catch_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ST_start" name="Задание на выгрузку">
      <bpmn:outgoing>SF_ST_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ST_start_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_upload" name="Выгрузить номенклатуру (агент/портал)">
      <bpmn:incoming>SF_ST_1</bpmn:incoming>
      <bpmn:outgoing>SF_ST_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="ST_catch_ready" name="Касса готова">
      <bpmn:incoming>SF_ST_2</bpmn:incoming>
      <bpmn:outgoing>SF_ST_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ST_catch_ready_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="ST_accept" name="Принять магазин по чек-листу">
      <bpmn:incoming>SF_ST_3</bpmn:incoming>
      <bpmn:outgoing>SF_ST_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ST_end" name="Магазин открыт">
      <bpmn:incoming>SF_ST_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_ST_1" sourceRef="ST_start" targetRef="ST_upload" />
    <bpmn:sequenceFlow id="SF_ST_2" sourceRef="ST_upload" targetRef="ST_catch_ready" />
    <bpmn:sequenceFlow id="SF_ST_3" sourceRef="ST_catch_ready" targetRef="ST_accept" />
    <bpmn:sequenceFlow id="SF_ST_4" sourceRef="ST_accept" targetRef="ST_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_AI" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_AI">
      <bpmn:lane id="L_AI" name="Матчинг">
        <bpmn:flowNodeRef>AI_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AI_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AI_score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AI_classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AI_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AI_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AI_start" name="Батч и снимок PIM">
      <bpmn:outgoing>SF_AI_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="AI_start_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="AI_match" name="Нормализовать и найти кандидатов">
      <bpmn:incoming>SF_AI_1</bpmn:incoming>
      <bpmn:outgoing>SF_AI_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AI_score" name="Оценить confidence и атрибуты">
      <bpmn:incoming>SF_AI_2</bpmn:incoming>
      <bpmn:outgoing>SF_AI_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="AI_classify" name="Классифицировать: auto / review / new">
      <bpmn:incoming>SF_AI_3</bpmn:incoming>
      <bpmn:outgoing>SF_AI_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="AI_send" name="Вернуть таблицу маппинга">
      <bpmn:incoming>SF_AI_4</bpmn:incoming>
      <bpmn:outgoing>SF_AI_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="AI_end" name="Матчинг завершён">
      <bpmn:incoming>SF_AI_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_AI_1" sourceRef="AI_start" targetRef="AI_match" />
    <bpmn:sequenceFlow id="SF_AI_2" sourceRef="AI_match" targetRef="AI_score" />
    <bpmn:sequenceFlow id="SF_AI_3" sourceRef="AI_score" targetRef="AI_classify" />
    <bpmn:sequenceFlow id="SF_AI_4" sourceRef="AI_classify" targetRef="AI_send" />
    <bpmn:sequenceFlow id="SF_AI_5" sourceRef="AI_send" targetRef="AI_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_PIM" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_PIM">
      <bpmn:lane id="L_PIM" name="Справочник и словарь">
        <bpmn:flowNodeRef>PIM_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIM_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIM_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIM_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIM_start" name="Мастер-данные и маппинг">
      <bpmn:outgoing>SF_PIM_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PIM_start_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PIM_update" name="Проверить карточки, обновить SKU и словарь">
      <bpmn:incoming>SF_PIM_1</bpmn:incoming>
      <bpmn:outgoing>SF_PIM_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="PIM_publish" name="Опубликовать ассортимент">
      <bpmn:incoming>SF_PIM_2</bpmn:incoming>
      <bpmn:outgoing>SF_PIM_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PIM_end" name="Ассортимент опубликован">
      <bpmn:incoming>SF_PIM_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_PIM_1" sourceRef="PIM_start" targetRef="PIM_update" />
    <bpmn:sequenceFlow id="SF_PIM_2" sourceRef="PIM_update" targetRef="PIM_publish" />
    <bpmn:sequenceFlow id="SF_PIM_3" sourceRef="PIM_publish" targetRef="PIM_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_ERP" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_ERP">
      <bpmn:lane id="L_ERP" name="Учёт и цены">
        <bpmn:flowNodeRef>ERP_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ERP_setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ERP_catch_assort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ERP_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ERP_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ERP_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ERP_start" name="Старт онбординга">
      <bpmn:outgoing>SF_ERP_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ERP_setup" name="Завести точку в ERP">
      <bpmn:incoming>SF_ERP_1</bpmn:incoming>
      <bpmn:outgoing>SF_ERP_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="ERP_catch_assort" name="Ассортимент из PIM">
      <bpmn:incoming>SF_ERP_2</bpmn:incoming>
      <bpmn:outgoing>SF_ERP_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ERP_catch_assort_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ERP_price" name="Проверить ассортимент и рассчитать цены">
      <bpmn:incoming>SF_ERP_3</bpmn:incoming>
      <bpmn:outgoing>SF_ERP_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ERP_publish" name="Опубликовать каталог и цены">
      <bpmn:incoming>SF_ERP_4</bpmn:incoming>
      <bpmn:outgoing>SF_ERP_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ERP_end" name="Каталог опубликован">
      <bpmn:incoming>SF_ERP_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_ERP_1" sourceRef="ERP_start" targetRef="ERP_setup" />
    <bpmn:sequenceFlow id="SF_ERP_2" sourceRef="ERP_setup" targetRef="ERP_catch_assort" />
    <bpmn:sequenceFlow id="SF_ERP_3" sourceRef="ERP_catch_assort" targetRef="ERP_price" />
    <bpmn:sequenceFlow id="SF_ERP_4" sourceRef="ERP_price" targetRef="ERP_publish" />
    <bpmn:sequenceFlow id="SF_ERP_5" sourceRef="ERP_publish" targetRef="ERP_end" />
  </bpmn:process>
  <bpmn:process id="Process_P_POS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_POS">
      <bpmn:lane id="L_POS" name="Касса">
        <bpmn:flowNodeRef>POS_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_catch_catalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>POS_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="POS_start" name="Старт онбординга">
      <bpmn:outgoing>SF_POS_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="POS_prep" name="Подготовить кассу: MDM, ККТ/ОФД">
      <bpmn:incoming>SF_POS_1</bpmn:incoming>
      <bpmn:outgoing>SF_POS_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="POS_catch_catalog" name="Каталог и цены">
      <bpmn:incoming>SF_POS_2</bpmn:incoming>
      <bpmn:outgoing>SF_POS_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="POS_catch_catalog_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="POS_test" name="Загрузить каталог и тест 20 SKU">
      <bpmn:incoming>SF_POS_3</bpmn:incoming>
      <bpmn:outgoing>SF_POS_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="POS_gw" name="Тест пройден?">
      <bpmn:incoming>SF_POS_4</bpmn:incoming>
      <bpmn:outgoing>SF_POS_5</bpmn:outgoing>
      <bpmn:outgoing>SF_POS_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="POS_blocked" name="Открытие заблокировано">
      <bpmn:incoming>SF_POS_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="POS_ready" name="Касса готова">
      <bpmn:incoming>SF_POS_5</bpmn:incoming>
      <bpmn:outgoing>SF_POS_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="POS_end" name="Касса принята">
      <bpmn:incoming>SF_POS_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_POS_1" sourceRef="POS_start" targetRef="POS_prep" />
    <bpmn:sequenceFlow id="SF_POS_2" sourceRef="POS_prep" targetRef="POS_catch_catalog" />
    <bpmn:sequenceFlow id="SF_POS_3" sourceRef="POS_catch_catalog" targetRef="POS_test" />
    <bpmn:sequenceFlow id="SF_POS_4" sourceRef="POS_test" targetRef="POS_gw" />
    <bpmn:sequenceFlow id="SF_POS_5" sourceRef="POS_gw" targetRef="POS_ready" name="да" />
    <bpmn:sequenceFlow id="SF_POS_6" sourceRef="POS_gw" targetRef="POS_blocked" name="нет" />
    <bpmn:sequenceFlow id="SF_POS_7" sourceRef="POS_ready" targetRef="POS_end" />
  </bpmn:process>
